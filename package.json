  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "@x402/evm": "^2.31.0",
    "@x402/fetch": "^2.31.0",
    "viem": "^2.57.11"
  },
  "peerDependencies": { "n8n-workflow": "*" },
  "devDependencies": {
    "n8n-workflow": "^2.16.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
